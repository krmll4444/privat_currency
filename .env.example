# Telegram (@BotFather → токен, @userinfobot → chat_id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Не потрібно: курс ФОП береться з публічного віджета otp24.
# Залиш порожнім. Заповни лише якщо хочеш Autoclient замість віджета.
PRIVAT_BUSINESS_TOKEN=
PRIVAT_BUSINESS_ID=

# Поріг вигідності: edgePct >= цього значення → сигнал у Telegram і зелений віджет.
# edgePct = (ланцюжок USD→EUR / курс НБУ − 1) * 100. Типово від'ємний (втрата vs НБУ).
# -1.0 означає «сповістити, якщо втрата не більша за 1%».
SPREAD_THRESHOLD_PCT=-1.0

# Не слати повторний сигнал частіше ніж раз на N годин, поки вікно лишається вигідним
NOTIFY_COOLDOWN_HOURS=6

# 1 = надсилати помилки фетчу в той самий чат
NOTIFY_ERRORS=0
