# Telegram (@BotFather → токен, @userinfobot → chat_id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Не потрібно: курс ФОП береться з публічного віджета otp24.
# Залиш порожнім. Заповни лише якщо хочеш Autoclient замість віджета.
PRIVAT_BUSINESS_TOKEN=
PRIVAT_BUSINESS_ID=

# Поріг вигідності: edgePct >= цього значення → сигнал у Telegram.
# edgePct = (ланцюжок USD→EUR / курс НБУ − 1) * 100. Типово від'ємний (втрата vs НБУ).
# -1.3 означає «сповістити, якщо втрата не більша за 1.3%». Живий спред часто ~−1.27%.
SPREAD_THRESHOLD_PCT=-1.3

# Додатково слати сигнал, якщо сьогодні в топ-N% днів історії (як підсвітка на графіку).
NOTIFY_TOP_PCT=10

# Сума профілю для доплати в грн (бот, advice.json, віджет). У мініапі ще localStorage.
TARGET_EUR=2000

# Цільова дата поїздки / платежу (YYYY-MM-DD). Порада «чи варто чекати ще N днів».
TARGET_DATE=

# Алерт, якщо спред покращився щонайменше на стільки пунктів за день (навіть без порогу).
NOTIFY_IMPROVE_PP=0.3

# Не слати повторний сигнал частіше ніж раз на N годин, поки вікно лишається вигідним
NOTIFY_COOLDOWN_HOURS=6

# 1 = надсилати помилки фетчу в той самий чат
NOTIFY_ERRORS=0

# GitHub Pages URL мініапу. npm run set-menu вішає кнопку в боті.
MINIAPP_URL=https://krmll4444.github.io/privat_currency/
MINIAPP_BUTTON_TEXT=Курс ФОП
